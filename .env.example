# Copy to .env.local and fill in. .env.local is git-ignored.

# Required: Google Gemini API key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Guardian Open Platform key for extra news (https://open-platform.theguardian.com)
GUARDIAN_API_KEY=

# Optional: comma-separated Gemini models to try in order (Flash models only).
# Leave empty to use the defaults in src/lib/ai/models.ts.
GEMINI_MODELS=
